# Secretos: configurar solo en Vercel, nunca en index.html.
APISPORTS_KEY=tu_api_football_key
ODDS_API_KEY=tu_the_odds_api_key

# Compatibilidad con el nombre utilizado por /api/calendar.
API_FOOTBALL_KEY=tu_api_football_key

# Mundial 2026 en API-Football.
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# Opcional. Se resuelve y valida primero contra GET /v4/sports.
# ODDS_SPORT_KEY=soccer_fifa_world_cup
ODDS_SPORT_TITLE_HINTS=FIFA World Cup,World Cup,soccer_fifa_world_cup
ODDS_REGIONS=eu,uk
ODDS_MARKETS=h2h
ODDS_SPORTS_STALE_TTL_MS=604800000
ODDS_STALE_TTL_MS=43200000

# none | basic (clasificación) | full (predicción, estadísticas, alineaciones y lesiones)
FOOTBALL_ENRICHMENT=basic
FOOTBALL_ENRICH_LIMIT=8
API_FOOTBALL_LIVE_STATS_TTL_MS=300000

# Acceso PRO con Firebase/Firestore.
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa a las tres variables anteriores:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PRO_USERS_COLLECTION=pro_users
ANALYSIS_SESSION_SECRET=genera_un_valor_largo_y_aleatorio
PRO_ADMIN_PASSWORD=elonmusk

# Reconciliación entre proveedores.
MATCH_TIME_WINDOW_MINUTES=90
MATCH_FUZZY_THRESHOLD=0.86
MATCH_ALLOW_SWAPPED=true
